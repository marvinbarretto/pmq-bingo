{
  "name": "pmq-bingo",
  "version": "0.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ghpages": "ng build --base-href /pmq-bingo/",
    "deploy": "npm run build:ghpages && npx angular-cli-ghpages --dir=dist/pmq-bingo/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "extract-sentences": "npx tsx scripts/extract-sentences.ts",
    "classify-sentences": "npx tsx scripts/classify-sentences.ts",
    "classify-gemini": "npx tsx scripts/classify-sentences-gemini.ts",
    "classify-labels": "npx tsx scripts/classify-with-labels.ts",
    "generate-phrase-bank": "npx tsx scripts/generate-phrase-bank.ts",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:first": "standard-version --first-release"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/cdk": "21.0.3",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@google/generative-ai": "0.24.1",
    "ollama": "0.6.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vosk-browser": "0.0.8"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "25.0.0",
    "jsdom": "^27.1.0",
    "standard-version": "9.5.0",
    "tsx": "4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
